      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "func-hv-shift-producer-<SUFFIX>",
      "location": "<PRIMARY_REGION>",
      "tags": {
        "purpose": "hv-shift-health-reporting"
      },
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', 'plan-hv-shift-producer-<SUFFIX>')]",
        "[resourceId('Microsoft.Storage/storageAccounts', 'sthvhost<SUFFIX>')]",
        "[resourceId('Microsoft.Insights/components', 'appi-hv-shift-<SUFFIX>')]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', 'plan-hv-shift-producer-<SUFFIX>')]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "https://sthvshift<SUFFIX>.blob.core.windows.net/deploy-producer",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "runtime": {
            "name": "python",
            "version": "3.12"
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": 40,
            "instanceMemoryMB": 2048
          }
        },
        "siteConfig": {
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "sthvhost<SUFFIX>"
            },
            {
              "name": "AzureWebJobsStorage__credential",
              "value": "managedidentity"
            },
            {
              "name": "APP_KIND",
              "value": "producer"
            },
            {
              "name": "REPORT_STORAGE_ACCOUNT",
              "value": "sthvshift<SUFFIX>"
            },
            {
              "name": "REPORT_QUEUE__queueServiceUri",
              "value": "https://sthvshift<SUFFIX>.queue.core.windows.net"
            },
            {
              "name": "REPORT_QUEUE__credential",
              "value": "managedidentity"
            },
            {
              "name": "ACS_ENDPOINT",
              "value": "https://acs-hv-shift-<SUFFIX>.asiapacific.communication.azure.com"
            },
            {
              "name": "ACS_SENDER",
              "value": "donotreply@00000000-0000-0000-0000-000000000000.azurecomm.net"
            },
            {
              "name": "GRAFANA_ENDPOINT",
              "value": "https://<GRAFANA_ENDPOINT>"
            },
            {
              "name": "RECIPIENT_ALLOWLIST",
              "value": "operator@example.com"
            },
            {
              "name": "SEND_ENABLED",
              "value": "false"
            },
            {
              "name": "SCHEDULE_ENABLED",
              "value": "false"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', 'appi-hv-shift-<SUFFIX>'), '2020-02-02').ConnectionString]"
            },
            {
              "name": "APPLICATIONINSIGHTS_AUTHENTICATION_STRING",
              "value": "Authorization=AAD"
            }
          ]
        }
      }
    },
