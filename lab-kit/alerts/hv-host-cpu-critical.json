{
  "properties": {
    "windowSize": "PT10M",
    "autoMitigate": true,
    "description": "Demo: operational starting threshold. Notifications are attached separately (see docs/setup/19-alerts.md).",
    "enabled": true,
    "severity": 1,
    "scopes": [
      "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-hyperv-arc-monitor-demo/providers/Microsoft.OperationalInsights/workspaces/law-arc-monitor-lab"
    ],
    "criteria": {
      "allOf": [
        {
          "timeAggregation": "Average",
          "threshold": 90,
          "failingPeriods": {
            "minFailingPeriodsToAlert": 1,
            "numberOfEvaluationPeriods": 1
          },
          "operator": "GreaterThan",
          "metricMeasureColumn": "Value",
          "query": "Perf | where Computer == \"HV-HOST-01\" and ObjectName == \"Hyper-V Hypervisor Logical Processor\" and CounterName == \"% Total Run Time\" and InstanceName == \"_Total\" | summarize Value=avg(CounterValue)"
        }
      ]
    },
    "actions": {
      "actionGroups": []
    },
    "evaluationFrequency": "PT5M",
    "displayName": "hv-host-cpu-critical"
  },
  "location": "<PRIMARY_REGION>",
  "name": "hv-host-cpu-critical"
}