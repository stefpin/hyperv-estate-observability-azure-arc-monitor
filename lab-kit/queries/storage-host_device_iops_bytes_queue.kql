Perf | where TimeGenerated > ago(30m) | where Computer == 'HV-HOST-01' and ObjectName == 'PhysicalDisk' and InstanceName != '_Total' | where CounterName in ('Disk Reads/sec','Disk Writes/sec','Disk Transfers/sec','Disk Read Bytes/sec','Disk Write Bytes/sec','Avg. Disk Queue Length','Avg. Disk Read Queue Length','Avg. Disk Write Queue Length','Current Disk Queue Length') | summarize Value=avg(CounterValue) by InstanceName, CounterName, bin(TimeGenerated,1m)