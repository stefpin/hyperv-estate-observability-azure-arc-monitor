HvLinuxDisk_CL | where TimeGenerated > ago(1h) | where Computer == 'RHEL94-GUEST' and AccountingScope == 'block-device' | extend ReadOps=ReadIOPS*IntervalSeconds, WriteOps=WriteIOPS*IntervalSeconds | summarize ReadOps=sum(ReadOps), WriteOps=sum(WriteOps), SampleSeconds=sum(IntervalSeconds), ReadLatencyNumerator=sum(ReadAwaitMs*ReadOps), WriteLatencyNumerator=sum(WriteAwaitMs*WriteOps), ReadBytes=sum(ReadKiBps*1024.0*IntervalSeconds), WriteBytes=sum(WriteKiBps*1024.0*IntervalSeconds), AvgQueueDepth=avg(AvgQueueDepth) by Computer, Device, bin(TimeGenerated,5m) | extend ReadIOPS=ReadOps/SampleSeconds, WriteIOPS=WriteOps/SampleSeconds, ReadAwaitMs=iff(ReadOps>0,ReadLatencyNumerator/ReadOps,real(null)), WriteAwaitMs=iff(WriteOps>0,WriteLatencyNumerator/WriteOps,real(null)), TransferAwaitMs=iff(ReadOps+WriteOps>0,(ReadLatencyNumerator+WriteLatencyNumerator)/(ReadOps+WriteOps),real(null)), ReadMiBps=ReadBytes/SampleSeconds/1048576.0, WriteMiBps=WriteBytes/SampleSeconds/1048576.0