Perf | where TimeGenerated > ago(30m) | where _ResourceId has '/resourcegroups/rg-hyperv-arc-monitor-demo/' | where ObjectName == 'LogicalDisk' and InstanceName contains ':' | where CounterName in ('Free Megabytes','% Free Space') | summarize arg_max(TimeGenerated,CounterValue) by Computer, InstanceName, CounterName | extend Value=iff(CounterName=='Free Megabytes',CounterValue/1024.0,CounterValue), Unit=iff(CounterName=='Free Megabytes','GiB','percent')