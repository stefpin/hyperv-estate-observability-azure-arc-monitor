patchinstallationresources | where resourceGroup =~ 'rg-hyperv-arc-monitor-demo' and type !contains 'softwarepatches' | extend Machine=tostring(split(id,'/')[8]) | where Machine =~ 'SQL2019-GUEST' | project Machine,Status=tostring(properties.status),Installed=toint(properties.installedPatchCount),Failed=toint(properties.failedPatchCount),Excluded=toint(properties.excludedPatchCount),RebootStatus=tostring(properties.rebootStatus),Updated=todatetime(properties.lastModifiedDateTime)