Perf | where TimeGenerated > ago(30m) | where Computer == 'HV-HOST-01' and ObjectName == 'Hyper-V Virtual Storage Device' | where InstanceName endswith '.vhdx' | where CounterName in ('Read Operations/Sec','Write Operations/Sec','Read Bytes/sec','Write Bytes/sec','Latency') | extend DisplayValue=iff(CounterName=='Latency',CounterValue*1000.0,CounterValue), Unit=case(CounterName=='Latency','ms',CounterName contains 'Bytes','B/s','IOPS') | summarize Value=avg(DisplayValue) by InstanceName, CounterName, Unit, bin(TimeGenerated,1m)