HvSqlMemory_CL
| where TimeGenerated > ago(30m)
| where Computer =~ "SQL2019-GUEST"
| extend NonFreeCommittedMB=TotalMemoryMB-FreeMemoryMB
| project TimeGenerated,Stage,MaxMemoryMB,TotalMemoryMB,FreeMemoryMB,NonFreeCommittedMB,CacheMemoryMB,GrantAllocatedMB,GrantUsedMB,PendingGrants,ProcessMB,OsAvailableMB
| order by TimeGenerated asc
