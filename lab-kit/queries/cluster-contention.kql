Perf | where TimeGenerated > ago(30m) and Computer == 'HV-HOST-01' and ObjectName == 'Hyper-V Hypervisor Virtual Processor' and CounterName == 'CPU Wait Time Per Dispatch' and InstanceName contains ':' | extend Guest=tostring(split(InstanceName,':')[0]) | where Guest in ('WIN2019-GUEST','WIN2022-GUEST','WIN2025-GUEST-01') | summarize MeanWaitNs=avg(CounterValue),P95WaitNs=percentile(CounterValue,95) by bin(TimeGenerated,1m)