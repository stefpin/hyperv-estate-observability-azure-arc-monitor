HvLinuxDisk_CL | where TimeGenerated > ago(30m) | where Computer == 'RHEL94-GUEST' and AccountingScope == 'block-device' | extend ReadBytesPerSecond=ReadKiBps*1024.0, WriteBytesPerSecond=WriteKiBps*1024.0, ReadWriteIOPS=ReadIOPS+WriteIOPS | project TimeGenerated, Computer, Device, ReadIOPS, WriteIOPS, ReadAwaitMs, WriteAwaitMs, ReadBytesPerSecond, WriteBytesPerSecond, AvgQueueDepth, UtilizationPct, MountedVolumes | order by TimeGenerated desc