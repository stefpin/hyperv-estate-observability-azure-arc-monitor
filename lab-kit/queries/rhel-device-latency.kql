HvLinuxDisk_CL | where TimeGenerated > ago(30m) and AccountingScope == 'block-device' | extend ReadOps=ReadIOPS*IntervalSeconds,WriteOps=WriteIOPS*IntervalSeconds | summarize ReadOps=sum(ReadOps),WriteOps=sum(WriteOps),ReadWeighted=sum(ReadAwaitMs*ReadOps),WriteWeighted=sum(WriteAwaitMs*WriteOps) by Device,bin(TimeGenerated,1m) | extend ReadLatencyMs=iff(ReadOps>0,ReadWeighted/ReadOps,real(null)),WriteLatencyMs=iff(WriteOps>0,WriteWeighted/WriteOps,real(null)) | project TimeGenerated,Device,ReadLatencyMs,WriteLatencyMs