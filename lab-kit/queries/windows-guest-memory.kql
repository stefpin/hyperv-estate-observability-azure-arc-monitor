let capacity=datatable(Computer:string,Bytes:real)['HV-HOST-01',68719476736.0,'SQL2019-GUEST',12884901888.0,'WIN2019-GUEST',8589934592.0,'WIN2022-GUEST',8589934592.0,'WIN2025-GUEST-01',8589934592.0]; Perf | where TimeGenerated > ago(30m) and ObjectName == 'Memory' and CounterName == 'Available Bytes' | summarize Available=avg(CounterValue) by Computer,bin(TimeGenerated,1m) | join kind=inner capacity on Computer | project TimeGenerated,Computer,UsedPercent=100.0*(1-Available/Bytes)