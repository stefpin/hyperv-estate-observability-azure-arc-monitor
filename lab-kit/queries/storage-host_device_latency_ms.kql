Perf | where TimeGenerated > ago(30m) | where Computer == 'HV-HOST-01' and ObjectName == 'PhysicalDisk' and InstanceName != '_Total' | where CounterName in ('Avg. Disk sec/Read','Avg. Disk sec/Write','Avg. Disk sec/Transfer') | extend LatencyMs=CounterValue*1000.0 | summarize LatencyMs=avg(LatencyMs) by InstanceName, CounterName, bin(TimeGenerated,1m)