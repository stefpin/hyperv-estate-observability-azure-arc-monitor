Perf | where TimeGenerated > ago(30m) | where _ResourceId has '/resourcegroups/rg-hyperv-arc-monitor-demo/' | where ObjectName == 'LogicalDisk' and InstanceName contains ':' | where CounterName in ('Avg. Disk sec/Read','Avg. Disk sec/Write','Avg. Disk sec/Transfer') | extend LatencyMs=CounterValue*1000.0 | summarize LatencyMs=avg(LatencyMs) by Computer, InstanceName, CounterName, bin(TimeGenerated,1m)