{
  "properties": {
    "dataFlows": [
      {
        "destinations": [
          "law-arc-monitor-lab"
        ],
        "streams": [
          "Microsoft-Perf",
          "Microsoft-Event"
        ]
      }
    ],
    "dataSources": {
      "performanceCounters": [
        {
          "counterSpecifiers": [
            "\\Hyper-V Hypervisor Logical Processor(_Total)\\% Total Run Time",
            "\\Hyper-V Hypervisor Logical Processor(*)\\% Guest Run Time",
            "\\Hyper-V Hypervisor Logical Processor(*)\\% Hypervisor Run Time",
            "\\Hyper-V Hypervisor Virtual Processor(*)\\CPU Wait Time Per Dispatch",
            "\\Hyper-V Hypervisor Root Virtual Processor(*)\\CPU Contention Time Per Dispatch",
            "\\Hyper-V Hypervisor Virtual Processor(*)\\% Total Run Time",
            "\\Hyper-V Hypervisor\\Virtual Processors",
            "\\Hyper-V Hypervisor\\Logical Processors",
            "\\Hyper-V Dynamic Memory Balancer(*)\\Available Memory",
            "\\Hyper-V Dynamic Memory VM(*)\\Physical Memory",
            "\\Hyper-V Virtual Storage Device(*)\\Latency",
            "\\Hyper-V Virtual Switch(*)\\Bytes/sec",
            "\\PhysicalDisk(*)\\Disk Reads/sec",
            "\\PhysicalDisk(*)\\Disk Writes/sec",
            "\\PhysicalDisk(*)\\Disk Transfers/sec",
            "\\PhysicalDisk(*)\\Disk Read Bytes/sec",
            "\\PhysicalDisk(*)\\Disk Write Bytes/sec",
            "\\PhysicalDisk(*)\\Disk Bytes/sec",
            "\\PhysicalDisk(*)\\Avg. Disk sec/Read",
            "\\PhysicalDisk(*)\\Avg. Disk sec/Write",
            "\\PhysicalDisk(*)\\Avg. Disk sec/Transfer",
            "\\PhysicalDisk(*)\\Avg. Disk Queue Length",
            "\\PhysicalDisk(*)\\Avg. Disk Read Queue Length",
            "\\PhysicalDisk(*)\\Avg. Disk Write Queue Length",
            "\\PhysicalDisk(*)\\Current Disk Queue Length",
            "\\Hyper-V Virtual Storage Device(*)\\Read Operations/Sec",
            "\\Hyper-V Virtual Storage Device(*)\\Write Operations/Sec",
            "\\Hyper-V Virtual Storage Device(*)\\Read Bytes/sec",
            "\\Hyper-V Virtual Storage Device(*)\\Write Bytes/sec"
          ],
          "name": "perfCountersHyperV",
          "samplingFrequencyInSeconds": 60,
          "streams": [
            "Microsoft-Perf"
          ]
        }
      ],
      "windowsEventLogs": [
        {
          "name": "eventLogsHyperV",
          "streams": [
            "Microsoft-Event"
          ],
          "xPathQueries": [
            "Microsoft-Windows-Hyper-V-VMMS-Admin!*[System[(Level=1 or Level=2 or Level=3)]]",
            "Microsoft-Windows-Hyper-V-Worker-Admin!*[System[(Level=1 or Level=2 or Level=3)]]"
          ]
        }
      ]
    },
    "destinations": {
      "logAnalytics": [
        {
          "name": "law-arc-monitor-lab",
          "workspaceResourceId": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-hyperv-arc-monitor-demo/providers/Microsoft.OperationalInsights/workspaces/law-arc-monitor-lab"
        }
      ]
    }
  },
  "location": "<PRIMARY_REGION>",
  "kind": "Windows"
}
